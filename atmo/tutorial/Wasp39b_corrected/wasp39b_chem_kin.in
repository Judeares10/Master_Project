! Namelist file for the Wasp39b: calculating chemical kinetics abundances with a read in PT profile, including
! vertical mixing and photochemistry

&UNITS
/

&PARAM 
Debug  = 0
fin = 'pt_wasp39b_corrected.ncdf'
/

&EOS gamma = 0./

&GRID 
ndepth = 50
teff   = 100.
mixing = t
kzzcst = 1e9
logg = 2.629
corr_k = t

/

&CHEMISTRY 
chem  = 'neq' 
fAin = 'chem_dummy.ncdf'
fAeqout  = 'wasp39-b_chem_kin_equilibrium.ncdf'
fAneqout = 'wasp39-b_chem_kin_kinetics_corrected(no_pc).ncdf'
mdh = 0.
init_eq = t
print_chem = t
/

&CHEM_NEQ
tmax = 1e9
photochem=f
fhnu_uv = 'hnu_uv_wasp39.ncdf'
mod_fuv = 5
mod_jac = 100
/

&RADTRANS 
rstar = 0.939
rorbit = 0.0482
fred = 0.5
murad = 0.5
/


&OPACITY 
nkap =12
/

&SOLVER 
solve_hydro  = f
solve_energy = f
/
 
&CONVECTION 
/

