! Namelist file for the tutorial chem_eq: calculating chemical equilibrium abundances with a read in PT profile

&UNITS 
/

&PARAM 
Debug  = 0
fin = 'pt_example.ncdf'
/

&EOS gamma = 0./

&GRID 
ndepth = 50
Rp = 1.257
corr_k = t
nband = 500
/

&CHEMISTRY 
chem  = 'cst' 
fAin = 'chem_example.ncdf'
/

&CHEM_NEQ
/

&CHEM_RELAX
/

&RADTRANS 
rstar = 1.118
firad='kurucz_hd209.ncdf'
irrad = t
scatter = f
fspectrum = 'spectrum_tutorial_emiss_spec_medres.ncdf'
/


&OPACITY 
nkap =12
/

&SOLVER 
solve_hydro  = f
solve_energy = f
surface_spectrum = t
/
 
&CONVECTION 
/

